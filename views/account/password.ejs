<%- include('../partials/head', { title }) %>
<% var rules = [{ key: 'len', label: 'At least 8 characters' }, { key: 'upper', label: 'One uppercase letter' }, { key: 'lower', label: 'One lowercase letter' }, { key: 'num', label: 'One number' }, { key: 'special', label: 'One special character (e.g. @ # ! $)' }]; %>
<section class="panel" style="max-width:560px">
  <h1>Change password</h1>
  <% if (user.must_change) { %><p class="errors">You are using a temporary password. Choose your own before continuing.</p><% } %>
  <form method="POST" action="/account/password" novalidate><input type="hidden" name="_csrf" value="<%= csrf %>">
    <%- include('../partials/password', { label: 'Current password', pname: 'current', E: errors, autocomplete: 'current-password', required: true }) %>
    <%- include('../partials/password', { label: 'New password', pname: 'password', E: errors, checklist: true, rules: rules, required: true }) %>
    <%- include('../partials/password', { label: 'Confirm new password', pname: 'password2', E: errors, required: true }) %>
    <p style="margin-top:1rem"><button class="btn" type="submit">Change password</button></p>
  </form>
</section>
<%- include('../partials/foot') %>
