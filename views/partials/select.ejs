<%
  var _E = (typeof E !== 'undefined' && E) ? E : {};
  var _err = _E[name] || '';
  var _sel = (typeof value !== 'undefined' && value !== null) ? String(value) : '';
%>
<div class="field">
  <label for="<%= name %>"><%= label %><% if (typeof required !== 'undefined' && required) { %> <span class="req" aria-hidden="true">*</span><span class="sr-only">(required)</span><% } %></label>
  <select id="<%= name %>" name="<%= name %>" class="<%= _err ? 'invalid' : '' %>" <%= (typeof required !== 'undefined' && required) ? 'required' : '' %>
    <% if (typeof attrs !== 'undefined') { %><%- attrs %><% } %>
    <% if (_err) { %>aria-invalid="true" aria-describedby="<%= name %>-err"<% } %>>
    <% if (typeof blank === 'undefined' || blank !== null) { %><option value=""><%= typeof blank !== 'undefined' ? blank : '— choose —' %></option><% } %>
    <% options.forEach(function (o) { %><option value="<%= o.value %>" <%= String(o.value) === _sel ? 'selected' : '' %> <% if (o.data) { %>data-program="<%= o.data %>"<% } %>><%= o.label %></option><% }); %>
  </select>
  <% if (_err) { %><p class="field-error" id="<%= name %>-err" role="alert"><%= _err %></p><% } %>
</div>
