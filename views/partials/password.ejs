<%
  var _E = (typeof E !== 'undefined' && E) ? E : {};
  var _pn = typeof pname !== 'undefined' ? pname : 'password';
  var _err = _E[_pn] || '';
%>
<div class="field">
  <label for="<%= _pn %>"><%= label %><% if (typeof required !== 'undefined' && required) { %> <span class="req" aria-hidden="true">*</span><span class="sr-only">(required)</span><% } %></label>
  <div class="pw-wrap">
    <input id="<%= _pn %>" name="<%= _pn %>" type="password" maxlength="72" autocomplete="<%= typeof autocomplete !== 'undefined' ? autocomplete : 'new-password' %>" class="<%= _err ? 'invalid' : '' %>"
      <% if (typeof checklist !== 'undefined' && checklist) { %>data-pw-check="1"<% } %>
      <% if (_err) { %>aria-invalid="true" aria-describedby="<%= _pn %>-err"<% } else if (typeof checklist !== 'undefined' && checklist) { %>aria-describedby="pw-rules"<% } %>>
    <button type="button" class="btn btn-ghost btn-sm" data-toggle-pw="<%= _pn %>" aria-pressed="false">Show</button>
  </div>
  <% if (typeof checklist !== 'undefined' && checklist) { %>
  <ul class="checklist" id="pw-rules" aria-label="Password requirements">
    <% rules.forEach(function (r) { %><li data-rule="<%= r.key %>"><span class="tick" aria-hidden="true">○</span> <%= r.label %></li><% }); %>
  </ul>
  <% } %>
  <% if (_err) { %><p class="field-error" id="<%= _pn %>-err" role="alert"><%= _err %></p><% } %>
</div>
