<%- include('partials/head', { title }) %>
<%
  var T = {
    valid:   ['VALID', 'This clearance is genuine and can be accepted.'],
    expired: ['EXPIRED', 'This clearance is genuine but its validity period has ended.'],
    revoked: ['REVOKED', 'This clearance was cancelled by the school. Do not accept it.'],
    used:    ['ALREADY USED', 'This clearance was already used for verification and cannot be accepted again.'],
    invalid: ['NOT FOUND', 'No clearance matches this code. It may be forged or mistyped.']
  };
%>
<section class="verdict v-<%= status %>" role="status">
  <h1><%= T[status][0] %></h1><p style="margin:.4rem 0 0"><%= T[status][1] %></p>
</section>
<% if (cert) { %>
<section class="panel">
  <h2>Clearance details</h2>
  <dl class="kv">
    <dt>Reference</dt><dd><%= cert.reference_no %></dd>
    <dt>Student</dt><dd><%= cert.given_name %> <%= cert.family_name %> (<%= cert.student_no %>)</dd>
    <dt>College</dt><dd><%= cert.college %></dd>
    <dt>Purpose</dt><dd><%= cert.purpose %><%= cert.purpose_other ? ' — ' + cert.purpose_other : '' %></dd>
    <dt>Term</dt><dd><%= cert.semester %> SY <%= cert.academic_year %></dd>
    <dt>Issued</dt><dd><%= fmt(cert.issued_at) %></dd><dt>Valid until</dt><dd><%= fmt(cert.expires_at) %></dd>
    <% if (cert.revoked_at) { %><dt>Revoked</dt><dd><%= fmt(cert.revoked_at) %> — <%= cert.revoked_reason %></dd><% } %>
    <% if (cert.used_at) { %><dt>Used</dt><dd><%= fmt(cert.used_at) %><%= cert.used_by_given ? ' by ' + cert.used_by_given + ' ' + cert.used_by_family : '' %></dd><% } %>
  </dl>
  <% if (canUse) { %>
    <form method="POST" action="/verify/<%= cert.token %>/use" style="margin-top:1rem"><input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="btn" type="submit">Accept and mark as used</button>
      <p class="hint">Do this once, when you actually release the credentials. After this the QR shows “already used”.</p></form>
  <% } %>
</section>
<% } %>
<%- include('partials/foot') %>
