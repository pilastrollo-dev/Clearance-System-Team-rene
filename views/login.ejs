<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Log in · CSPC Digital Clearance</title>
  <link rel="icon" href="/img/logo.png">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login">
<main id="main">
  <div class="login-card">
    <p class="eyebrow">CSPC Digital Clearance</p>
    <h1>Log in</h1>
    <p class="sub">Students, instructors, office staff and admin all sign in here.</p>
    <span class="pill"><%= term %></span>
    <% if (errors.length) { %><div class="errors" role="alert"><ul><% errors.forEach(function (e) { %><li><%= e %></li><% }); %></ul></div><% } %>
    <form method="POST" action="/login" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="username" maxlength="120" placeholder="name@my.cspc.edu.ph" value="<%= old.email || '' %>" autofocus required>
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" maxlength="72" required>
      <button class="btn" type="submit">Log in</button>
    </form>
  </div>
</main>
<footer class="foot" style="text-align:center"><small>CCIT106 · CSPC · &copy; 2026 · We collect your name, student number and e-mail only to process your clearance.<br>Data is kept for one academic year.</small></footer>
</body></html>
