PORT=3001
# Address printed inside every QR code. Use your LAN IP (e.g. http://192.168.1.20:3001) if phones must scan it.
APP_URL=http://localhost:3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=teamrene_clearance
SESSION_SECRET=change-me-to-a-long-random-string
# Shown only if no current term exists in the database
TERM_LABEL=1st Sem SY 2026–2027
# Defaults for deadlines / reminders (the admin can change them later under Settings)
APPROVAL_DUE_HOURS=48
DUE_SOON_HOURS=24
REMIND_EVERY_HOURS=24
ESCALATE_AFTER_HOURS=24
QR_VALID_DAYS=90
# How often the reminder job runs
SCHEDULER_MINUTES=15
